-- ║              LOGIKA DETEKSI NOTIFIKASI                    ║
-- ╚══════════════════════════════════════════════════════════╝
-- Notifikasi struktur (dari info user):
--   [TextButton] PlayerGui."Re:NotifyClient".<UUID>      <- ini "child"
--     [TextLabel] Label   (Text = "Match still in progress")
--     [Frame] Options
--       [TextButton] Accept   (Text = "Rejoin")
local function handleNotification(child)
    if not child then return end

    -- Kita gak peduli child:IsA("Frame") doang. Notif bisa TextButton.
    -- Cukup pastikan dia GuiObject yang punya Label child.
    local label = child:WaitForChild(PathConfig.LabelChildName, PathConfig.LabelWaitTimeout)
    if not label then
        dprint("Skip: child", child.Name, "tidak punya Label.")
        return
    end
    if not label:IsA("TextLabel") then return end
    if label.Text ~= PathConfig.MatchLabelText then
        dprint("Skip: Label.Text bukan rejoin notif (", label.Text, ")")
        return
    end

    currentFoundUUID  = child.Name
    currentFoundFrame = child

    print("========================================")
    print("[AutoJoinOldGameV3] Notifikasi rejoin terdeteksi!")
    print("[AutoJoinOldGameV3] UUID :", tostring(currentFoundUUID))
    print("[AutoJoinOldGameV3] Path :", child:GetFullName())
    print("========================================")

    if isAutoRejoinActive then
        StatusLabel.Text = "Auto klik (path pasti)..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        local ok, msg = executeRejoin()
        StatusLabel.Text = (ok and "OK: " or "FAIL: ") .. tostring(msg)
        StatusLabel.TextColor3 = ok and Color3.fromRGB(85, 255, 127) or Color3.fromRGB(255, 85, 85)
    else
        StatusLabel.Text = "Notif siap! Tekan Manual."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
    end
end

local function setupDetection()
    local notifyFolder = PlayerGui:WaitForChild(PathConfig.NotifyFolderName, PathConfig.NotifyFolderTimeout)
    if not notifyFolder then
        warn("[AutoJoinOldGameV3] Timeout: " .. PathConfig.NotifyFolderName .. " tidak ditemukan!")
        StatusLabel.Text = "Gagal menemukan folder notif."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
        return
    end

    -- Cek anak yang sudah ada saat inject
    for _, child in ipairs(notifyFolder:GetChildren()) do
        task.spawn(handleNotification, child)
    end

    -- Listen anak baru
    autoRejoinConnection = notifyFolder.ChildAdded:Connect(function(child)
        task.spawn(handleNotification, child)
    end)

    dprint("Script ter-inject. Listen folder:", notifyFolder:GetFullName())
end


