    StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    local ok, msg = executeRejoin()
    StatusLabel.Text = (ok and "OK: " or "FAIL: ") .. tostring(msg)
    StatusLabel.TextColor3 = ok and Color3.fromRGB(85, 255, 127) or Color3.fromRGB(255, 85, 85)
end)

MinBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    applyMinimizeState()
end)

CloseBtn.MouseButton1Click:Connect(function()
    if autoRejoinConnection then autoRejoinConnection:Disconnect() end
    ScreenGui:Destroy()
end)

setupDetection()
