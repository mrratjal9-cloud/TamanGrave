-- (b) Workspace scan: banyak TD pakai folder workspace.PlayerUnits[<UserId>]
--     atau workspace.Units. Anak-anaknya = Model dengan Name = unitName +
--     attribute UnitId, ATAU Name = "<unitName>_<id>". Coba kedua-duanya.
function _AUTOSELL.scanWorkspace()
    if not CONFIG.SELL_USE_WORKSPACE_SCAN then return end
    local function tryFolder(folder)
        if not folder then return end
        for _, m in ipairs(folder:GetChildren()) do
            local id, name
            pcall(function()
                id = m:GetAttribute("UnitId") or m:GetAttribute("Id")
                       or m:GetAttribute("unitId") or m:GetAttribute("ID")
                name = m:GetAttribute("UnitName") or m:GetAttribute("UnitType")
                       or m:GetAttribute("Name")
            end)
            if not id then
                for _, c in ipairs(m:GetChildren()) do
                    if c:IsA("IntValue") or c:IsA("NumberValue") then
                        local lname = string.lower(c.Name)
                        if string.find(lname, "id", 1, true) then
                            local v = tonumber(c.Value)
                            if v then id = v; break end
                        end
                    end
                end
            end
            if not id then
                local digits = string.match(m.Name or "", "_(%d+)$")
                if digits then id = tonumber(digits) end
            end
            if not name and type(m.Name) == "string" then
                if startsWith(m.Name, "unit_") then
                    local clean = string.match(m.Name, "^(unit_[%w_]-)_%d+$") or m.Name
                    name = clean
                end
            end
            if id then
                _AUTOSELL.register(id, name, "WS:" .. tostring(folder.Name))
            end
        end
    end

    pcall(function()
        local ws = workspace
        local pUnits = ws:FindFirstChild("PlayerUnits") or ws:FindFirstChild("Units")
        if pUnits then
            local mine = pUnits:FindFirstChild(tostring(LocalPlayer.UserId))
            if mine then tryFolder(mine) else tryFolder(pUnits) end
        end
        local pUnits2 = ws:FindFirstChild("Towers") or ws:FindFirstChild("Placed")
        if pUnits2 then tryFolder(pUnits2) end
    end)
end

-- (c) UI scan: ambil UnitId dari tiap item di UnitManager.
function _AUTOSELL.scanUi()
    if not CONFIG.SELL_USE_UI_SCAN then return end
    pcall(function()
        local pGui    = LocalPlayer:FindFirstChild("PlayerGui")
        local gameGui = pGui    and pGui:FindFirstChild("GameGui")
        local screen  = gameGui and gameGui:FindFirstChild("Screen")
        local middle  = screen  and screen:FindFirstChild("Middle")
        local unitMgr = middle  and middle:FindFirstChild("UnitManager")
        local items1  = unitMgr and unitMgr:FindFirstChild("Items")
        local frame   = items1  and items1:FindFirstChild("Frame")
        local items2  = frame   and frame:FindFirstChild("Items")
        local items3  = items2  and items2:FindFirstChild("Items")
        local scroll  = items3  and items3:FindFirstChild("ScrollingFrame")
        if not scroll then return end
        for _, child in ipairs(scroll:GetChildren()) do
            if startsWith(child.Name or "", "unit_") then
                local id
                pcall(function()
                    id = child:GetAttribute("UnitId") or child:GetAttribute("Id")
                           or child:GetAttribute("unitId") or child:GetAttribute("ID")
                end)
                if not id then
                    for _, c in ipairs(child:GetChildren()) do
                        if c:IsA("IntValue") or c:IsA("NumberValue")
                           or c:IsA("StringValue") then
                            local lname = string.lower(c.Name)
                            if string.find(lname, "id", 1, true) then
                                id = tonumber(c.Value); if id then break end
                            end
                        end
                    end
                end
                if not id then
                    local digits = string.match(child.Name, "_(%d+)$")
                    if digits then id = tonumber(digits) end
                end
                if id then
                    local clean = string.match(child.Name, "^(unit_[%w_]-)_%d+$") or child.Name
                    _AUTOSELL.register(id, clean, "UI")
                end
            end
        end
    end)
end

function _AUTOSELL.refreshIndex()
    _AUTOSELL.scanWorkspace()
    _AUTOSELL.scanUi()
end

-- Kumpulkan UnitId yg cocok dgn list nama yg ingin di-sell.
-- (V4) Logic: kalau CONFIG.SELL_TARGET_UNITS kosong -> fallback ke TARGET_UNIT.
function _AUTOSELL.buildIdList()
    local wantSet = {}
    if type(CONFIG.SELL_TARGET_UNITS) == "table" and #CONFIG.SELL_TARGET_UNITS > 0 then
        for _, n in ipairs(CONFIG.SELL_TARGET_UNITS) do
            if type(n) == "string" and #n > 0 then wantSet[n] = true end
        end
    elseif CONFIG.TARGET_UNIT then
        wantSet[CONFIG.TARGET_UNIT] = true
    end
    local list = {}
    for id, info in pairs(_AUTOSELL.index) do
        local nm = info.unitName
        if nm and wantSet[nm] then
            table.insert(list, id)
        end
    end
    return list, wantSet
end

-- Trigger 1: SELL ALL (semua unit, tanpa pandang tipe)
function _AUTOSELL.sellAll()
    local remote = _AUTOSELL.getSellAllRemote()
    if not remote then
        warn("[AutoSellV2] SellAll remote tidak ditemukan di RemoteFunctions.")
        _AUTOSELL.lastSummary = "FAIL: remote SellAll tidak ada"
        return false, "no-remote"
    end
    local before = lastUIAllUnits
    local ok, ret = pcall(function() return remote:InvokeServer() end)
    _AUTOSELL.countAll = _AUTOSELL.countAll + 1
    local success = isSuccessReturn(ok, ret)
    if CONFIG.SELL_DEBUG then
        print(string.format("[AutoSellV2] SellAll invoked | ok=%s ret=%s before=%d",
            tostring(ok), tostring(ret), before))
    end
    if success then
        _AUTOSELL.index = {}
    end
    _AUTOSELL.lastSummary = string.format("SellAll @W%d (count=%d)",
        lastWaveNum or -1, _AUTOSELL.countAll)
    return success, ret
end

-- Trigger 2: SELL TARGET (hanya unit yg namanya match list)
function _AUTOSELL.sellTarget()
    local remote = _AUTOSELL.getSellUnitRemote()
    if not remote then
        warn("[AutoSellV2] SellUnit remote tidak ditemukan di RemoteFunctions.")
        _AUTOSELL.lastSummary = "FAIL: remote SellUnit tidak ada"
        return false, "no-remote"
    end
    _AUTOSELL.refreshIndex()
    local idList, wantSet = _AUTOSELL.buildIdList()
    if CONFIG.SELL_DEBUG then
        local names = {}
        for n, _ in pairs(wantSet) do table.insert(names, n) end
        print(string.format("[AutoSellV2] SellTarget @W%d wants={%s} foundIds=%d",
            lastWaveNum or -1, table.concat(names, ","), #idList))
    end
    if #idList == 0 then
        _AUTOSELL.lastSummary = string.format("SellTarget @W%d: 0 ID found", lastWaveNum or -1)
        warn("[AutoSellV2] Tidak ada UnitId yg match list -> sell di-skip.")
        return false, "no-id"
    end

    local okCount, failCount = 0, 0
    for _, id in ipairs(idList) do
        local triesLeft = (CONFIG.SELL_RETRY_AFTER_FAIL or 0) + 1
        local sold = false
        while triesLeft > 0 and not sold do
            triesLeft = triesLeft - 1
            local ok, ret = pcall(function()
                return remote:InvokeServer(id)
            end)
            local success = isSuccessReturn(ok, ret)
            if CONFIG.SELL_DEBUG then
                print(string.format("[AutoSellV2] SellUnit(%d) ok=%s ret=%s success=%s",
                    id, tostring(ok), tostring(ret), tostring(success)))
            end
            if success then
                sold = true
                okCount = okCount + 1
                _AUTOSELL.countUnit = _AUTOSELL.countUnit + 1
                _AUTOSELL.unregister(id)
            else
                if triesLeft > 0 then
                    task.wait(CONFIG.SELL_PER_UNIT_DELAY or 0.1)
                end
            end
        end
        if not sold then failCount = failCount + 1 end
        task.wait(CONFIG.SELL_PER_UNIT_DELAY or 0.1)
    end
    _AUTOSELL.lastSummary = string.format("SellTarget @W%d ok=%d fail=%d (total ok=%d)",
        lastWaveNum or -1, okCount, failCount, _AUTOSELL.countUnit)
    return (okCount > 0), { ok = okCount, fail = failCount }
end

-- Hook trigger berdasarkan wave. Dipanggil dari processWaveSnapshot setelah
-- lastWaveNum di-update.
function _AUTOSELL.maybeTrigger(newWave)
    if not CONFIG.AUTO_SELL_ENABLED then return end
    if type(newWave) ~= "number" then return end

    local pauseSec = CONFIG.SELL_PAUSE_PLACEMENT_SEC or 0
    local function applyPause(reason)
        if pauseSec > 0 then
            pausedUntil = math.max(pausedUntil, os.clock() + pauseSec)
            if CONFIG.SELL_DEBUG then
                print(string.format("[AutoSellV2] Placement paused %.2fs (%s)",
                    pauseSec, reason))
            end
        end
    end

    local sa = CONFIG.SELL_ALL_AT_WAVE or 0
    if sa > 0 and newWave == sa and not _AUTOSELL.triggered[("ALL_"..sa)] then
        _AUTOSELL.triggered[("ALL_"..sa)] = true
        print(string.format("[AutoSellV2] >>> Wave %d reached -> trigger SELL ALL <<<", newWave))
        task.spawn(function()
            applyPause("SellAll")
            pcall(_AUTOSELL.sellAll)
        end)
    end

    local st = CONFIG.SELL_TARGET_AT_WAVE or 0
    if st > 0 and newWave == st and not _AUTOSELL.triggered[("TGT_"..st)] then
        _AUTOSELL.triggered[("TGT_"..st)] = true
        print(string.format("[AutoSellV2] >>> Wave %d reached -> trigger SELL TARGET <<<", newWave))
        task.spawn(function()
            applyPause("SellTarget")
            pcall(_AUTOSELL.sellTarget)
        end)
    end
end

