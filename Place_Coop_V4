local function isSuccessReturn(ok, ret)
    if not ok then return false end
    if ret == false then return false end
    if type(ret) == "string" then
        local low = strLower(ret)
        if strContains(low, "fail") then return false end
        if strContains(low, "insufficient") then return false end
        if strContains(low, "not enough") then return false end
        if strContains(low, "cannot") then return false end
        if strContains(low, "error") then return false end
    end
    if type(ret) == "table" and ret.success == false then return false end
    return true
end


-- ==========================================
-- (V2 NEW) UNIT ID TRACKER  +  AUTO-SELL MODULE
-- ==========================================
-- Masalah utama: remote SellUnit butuh UnitId (angka random per-unit yg di-
-- generate server). Tidak bisa ditebak. Solusi: kumpulkan dari 3 sumber:
--   (a) PLACEMENT RETURN  -> hasil InvokeServer(PlaceUnit, ...) sering balik
--                            sebuah angka / table yg memuat UnitId baru.
--   (b) WORKSPACE SCAN    -> banyak game TD nyimpen instance unit di
--                            workspace.PlayerUnits[<UserId>] / workspace.Units.
--   (c) UI SCAN           -> tiap item di UnitManager.Items.<...>.ScrollingFrame
--                            sering punya Attribute "UnitId"/"Id" atau IntValue.
-- Hasilnya disimpan di _AUTOSELL.index = { [UnitId] = { unitName=..., src=... } }.
-- (V2 catatan: SEMUA state + helper auto-sell di-bundle dlm 1 table _AUTOSELL
--  untuk hemat slot local di main chunk Lua/Luau, batas 200.)

local _AUTOSELL = {
    index        = {},   -- map: [unitId] = { unitName=str, src=str, ts=os.clock() }
    triggered    = {},   -- map: ["ALL_<wave>"]/"TGT_<wave>" = true (anti double trigger)
    countAll     = 0,    -- total invoke SellAll selama session
    countUnit    = 0,    -- total invoke SellUnit sukses selama session
    lastSummary  = "-",  -- string utk GUI
}

-- (a) Coba ekstrak UnitId dari nilai apapun yg dibalikin remote PlaceUnit.
--     Bisa berupa: number langsung, table {id=N}, table {1=N}, string "id=123".
function _AUTOSELL.extractId(v, depth)
    depth = depth or 0
    if depth > 4 then return nil end
    local tv = type(v)
    if tv == "number" and v > 0 and v < 1e12 then return math.floor(v) end
    if tv == "string" then
        local n = string.match(v, "(%d+)")
        if n then
            local nv = tonumber(n)
            if nv and nv > 100 then return nv end
        end
        return nil
    end
    if tv == "table" then
        local keys = { "id","Id","ID","unitId","UnitId","UnitID","unit_id" }
        for _, k in ipairs(keys) do
            local x = v[k]
            if x ~= nil then
                local got = _AUTOSELL.extractId(x, depth + 1)
                if got then return got end
            end
        end
        for i = 1, 3 do
            local got = _AUTOSELL.extractId(v[i], depth + 1)
            if got then return got end
        end
    end
    return nil
end

-- Daftarkan UnitId baru ke index. unitName boleh nil (akan diisi belakangan
-- saat scan).
function _AUTOSELL.register(unitId, unitName, src)
    if type(unitId) ~= "number" or unitId <= 0 then return end
    local existing = _AUTOSELL.index[unitId]
    if existing then
        if unitName and not existing.unitName then existing.unitName = unitName end
        return
    end
    _AUTOSELL.index[unitId] = {
        unitName = unitName,
        src      = src or "?",
        ts       = os.clock(),
    }
    if CONFIG.SELL_DEBUG then
        print(string.format("[AutoSellV2] register UnitId=%d name=%s src=%s",
            unitId, tostring(unitName), tostring(src)))
    end
end

function _AUTOSELL.unregister(unitId)
    if _AUTOSELL.index[unitId] ~= nil then
        _AUTOSELL.index[unitId] = nil
    end
end

-- Helper: ambil folder RemoteFunctions
function _AUTOSELL.rfFolder()
