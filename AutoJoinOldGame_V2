-- ╔══════════════════════════════════════════════════════════╗
-- ║       VIRTUAL CLICK 3-METHOD (port dari V3)               ║
-- ╚══════════════════════════════════════════════════════════╝
-- 100% pola yang sama dengan AutoReplay_Map_Grave_V3.
-- Method 1: getconnections + :Fire() / firesignal(c)
local function clickViaConnections(button)
    if typeof(getconnections) ~= "function" then return false end
    local fired = false
    local signals = { "MouseButton1Click", "Activated", "MouseButton1Down", "MouseButton1Up" }
    for _, sig in ipairs(signals) do
        pcall(function()
            local ev = button[sig]
            if ev then
                local conns = getconnections(ev)
                if conns then
                    for _, c in ipairs(conns) do
                        local ok = pcall(function() c:Fire() end)
                        if not ok and typeof(firesignal) == "function" then
                            pcall(function() firesignal(c) end)
                        end
                        fired = true
                    end
                end
            end
        end)
    end
    return fired
end

-- Method 2: firesignal langsung di event tombolnya
local function clickViaFiresignal(button)
    if typeof(firesignal) ~= "function" then return false end
    local signals = { "MouseButton1Down", "MouseButton1Up", "MouseButton1Click", "Activated" }
    local fired = false
    for _, sig in ipairs(signals) do
        pcall(function()
            if button[sig] then
                firesignal(button[sig])
                fired = true
            end
        end)
    end
    return fired
end

-- Method 3: VirtualInputManager (paling natural, butuh izin)
local function clickViaVIM(button)
    if not ClickConfig.AllowVIM then return false end
    if not VirtualInputManager then return false end
    local ok = pcall(function()
        local pos  = button.AbsolutePosition
        local size = button.AbsoluteSize
        local x = pos.X + size.X / 2
        local y = pos.Y + size.Y / 2
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true,  game, 0)
        task.wait(0.07)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    return ok
end

-- Kombinator 3-method dengan attempt-aware (sama persis V3).
local function virtualClick(button, attempt)
    if not button then return end
    attempt = attempt or 1

    local targets = { button }
    if ClickConfig.ClickTitleChild then
        local title = button:FindFirstChild("Title")
        if title and (title:IsA("TextLabel") or title:IsA("ImageLabel")
                      or title:IsA("TextButton") or title:IsA("ImageButton")) then
            table.insert(targets, title)
        end
    end

    for _, t in ipairs(targets) do
        if attempt == 1 then
            clickViaConnections(t)
            clickViaFiresignal(t)
        elseif attempt == 2 then
            clickViaFiresignal(t)
            clickViaVIM(t)
        else
            clickViaVIM(t)
            clickViaConnections(t)
            clickViaFiresignal(t)
        end
    end
end


-- ╔══════════════════════════════════════════════════════════╗
-- ║          PENCARIAN TOMBOL ACCEPT DI NOTIFIKASI            ║
-- ╚══════════════════════════════════════════════════════════╝
-- Cek apakah obj kelihatan seperti tombol Accept (by name / text).
local function looksLikeAccept(obj)
    if not obj then return false end

    -- match by name
    for _, n in ipairs(DetectConfig.AcceptButtonNames) do
        if obj.Name == n then return true end
    end

    -- match by text (kalau dia TextButton/TextLabel)
    if obj:IsA("TextButton") or obj:IsA("TextLabel") then
        local t = string.lower(tostring(obj.Text or ""))
        for _, kw in ipairs(DetectConfig.AcceptButtonText) do
            if t == kw then return true end
            if string.find(t, kw, 1, true) then return true end
        end
    end

    return false
end

-- DFS rekursif terbatas kedalaman, prioritas TextButton/ImageButton.
local function findAcceptButton(root, depth)
    if not root or depth > DetectConfig.SearchDepth then return nil end

    -- Pertama cek anak langsung dulu (BFS-style di level dangkal lebih
    -- akurat, biar kalau ada banyak label "Accept" yang nyangkut, yang
    -- ke-pilih adalah yang paling dekat ke root).
    for _, child in ipairs(root:GetChildren()) do
        if (child:IsA("TextButton") or child:IsA("ImageButton")) and looksLikeAccept(child) then
            return child
        end
    end

    -- Lalu cek anak lain yang bukan button tapi name-nya cocok
    -- (kadang button dibungkus Frame "Accept" lalu di dalamnya ada
    -- TextButton/ImageButton beneran).
    for _, child in ipairs(root:GetChildren()) do
        if looksLikeAccept(child) then
            -- cari turunan tipe button
            for _, desc in ipairs(child:GetDescendants()) do
                if desc:IsA("TextButton") or desc:IsA("ImageButton") then
                    return desc
                end
            end
            -- kalau gak ada turunan button, return obj-nya sendiri
            -- (mungkin ImageLabel yg dibungkus signal di luar)
            return child
        end
    end

    -- Rekursi ke anak-anak
    for _, child in ipairs(root:GetChildren()) do
        local found = findAcceptButton(child, depth + 1)
        if found then return found end
    end

    return nil
end


-- ╔══════════════════════════════════════════════════════════╗
-- ║                    EKSEKUSI REJOIN (V2)                   ║
-- ╚══════════════════════════════════════════════════════════╝
-- LANGKAH:
--   1) cek currentFoundFrame masih hidup (Parent ~= nil).
--   2) cari tombol Accept di dalam frame -> KLIK pakai virtualClick
--      (3-method, sama persis V3) sebanyak ClickRetry kali.
--   3) kalau tombol gak ketemu DAN UseFireServerFallback=true,
--      fallback ke FireServer (warisan V1) supaya tetep work.
--   4) update StatusLabel.
local function executeRejoin()
    local statusOk, statusErr

    -- (a) Validasi UUID
    if not currentFoundUUID or currentFoundUUID == "" then
        statusErr = "Error: UUID Kosong!"
        warn("[AutoJoinOldGameV2] Gagal: UUID kosong / belum terdeteksi.")
        return false, statusErr
    end

    dprint("Mencoba rejoin UUID:", currentFoundUUID)

    -- (b) Coba klik tombol GUI dulu
    local clickedViaGui = false
    if currentFoundFrame and currentFoundFrame.Parent then
        local btn = findAcceptButton(currentFoundFrame, 0)
        if btn then
            dprint("Tombol Accept ditemukan:", btn:GetFullName())
            for i = 1, ClickConfig.ClickRetry do
                virtualClick(btn, i)
                clickedViaGui = true
                if i < ClickConfig.ClickRetry then task.wait(ClickConfig.ClickGap) end
                -- kalau notifikasi udah ilang, berhenti retry
                if not (currentFoundFrame and currentFoundFrame.Parent) then break end
            end
            statusOk = "Klik GUI terkirim (3-method V3)"
        else
            dprint("Tombol Accept TIDAK ditemukan di dalam frame notifikasi.")
        end
    else
        dprint("Frame notifikasi sudah hilang / belum tertangkap.")
    end

    -- (c) Fallback FireServer (warisan V1) kalau klik GUI gagal
    if not clickedViaGui and ClickConfig.UseFireServerFallback then
        local reNotifyEvent = ReplicatedStorage:FindFirstChild(RemoteConfig.EventName)
        if reNotifyEvent then
            local ok = pcall(function()
                reNotifyEvent:FireServer(RemoteConfig.ActionId, currentFoundUUID, RemoteConfig.AcceptOption)
            end)
            if ok then
                dprint("Fallback FireServer terkirim ->", RemoteConfig.ActionId, currentFoundUUID, RemoteConfig.AcceptOption)
                statusOk = "Fallback FireServer terkirim"
            else
                statusErr = "Error: FireServer gagal!"
                warn("[AutoJoinOldGameV2] FireServer error.")
            end
        else
            statusErr = "Error: Remote tidak ada!"
            warn("[AutoJoinOldGameV2] ReNotifyEvent tidak ditemukan di ReplicatedStorage.")
        end
    end

    if statusOk then return true, statusOk end
    if statusErr then return false, statusErr end
    return false, "Tidak ada aksi (cek log F9)"
end


