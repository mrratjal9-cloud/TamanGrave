-- ║              LOGIKA DETEKSI NOTIFIKASI (sama V1)          ║
-- ╚══════════════════════════════════════════════════════════╝
-- V2: SELAIN simpan UUID, kita SIMPAN juga referensi Frame
-- supaya bisa cari tombol GUI di dalamnya untuk diklik.
local function handleNotification(child)
    task.wait(0.5) -- tunggu UI render full

    if child:IsA("Frame") or child:IsA("GuiObject") then
        local label = child:FindFirstChild("Label")
        if label and label:IsA("TextLabel") and label.Text == DetectConfig.MatchLabelText then
            currentFoundUUID  = child.Name
            currentFoundFrame = child   -- V2: simpen frame ref!

            print("========================================")
            print("[AutoJoinOldGameV2] Notifikasi Muncul!")
            print("[AutoJoinOldGameV2] UUID:", tostring(currentFoundUUID))
            print("[AutoJoinOldGameV2] Frame:", child:GetFullName())
            print("========================================")

            if isAutoRejoinActive then
                StatusLabel.Text = "Auto Klik (3-method)..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                local ok2, msg = executeRejoin()
                StatusLabel.Text = (ok2 and "OK: " or "FAIL: ") .. tostring(msg)
                StatusLabel.TextColor3 = ok2 and Color3.fromRGB(85, 255, 127) or Color3.fromRGB(255, 85, 85)
            else
                StatusLabel.Text = "Notif siap! Tekan Manual."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
            end
        end
    end
end

local function setupDetection()
    local notifyClientFolder = PlayerGui:WaitForChild(DetectConfig.NotifyFolderName, DetectConfig.NotifyFolderTimeout)
    if notifyClientFolder then
        for _, child in ipairs(notifyClientFolder:GetChildren()) do
            task.spawn(handleNotification, child)
        end
        autoRejoinConnection = notifyClientFolder.ChildAdded:Connect(handleNotification)
        dprint("Script ter-inject. Menunggu notifikasi.")
    else
        warn("[AutoJoinOldGameV2] Timeout: Folder " .. DetectConfig.NotifyFolderName .. " tidak ditemukan!")
        StatusLabel.Text = "Gagal menemukan Folder UI."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
    end
end


