-- ==========================================
-- 2. SISTEM DRAG GUI
-- ==========================================
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging, dragStart, startPos = true, input.Position, MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ==========================================
-- 3. FUNGSI EKSEKUSI REMOTE (DEBUGGER)
-- ==========================================
local function executeRejoin(uuid)
    if not uuid or uuid == "" then
        StatusLabel.Text = "Error: UUID Kosong!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
        warn("[DEBUG AUTO-REJOIN] Gagal mengeksekusi, UUID kosong atau belum terdeteksi.")
        return
    end

    print("[DEBUG AUTO-REJOIN] Mencoba mengirim RemoteEvent dengan UUID: " .. tostring(uuid))
    local reNotifyEvent = ReplicatedStorage:FindFirstChild("ReNotifyEvent")
    
    if reNotifyEvent then
        -- Trigger Remote Server
        reNotifyEvent:FireServer("NotificationOptionSelected", uuid, "Accept")
        print("[DEBUG AUTO-REJOIN] Berhasil FireServer -> NotificationOptionSelected | " .. tostring(uuid) .. " | Accept")
        
        StatusLabel.Text = "Command Dikirim (Cek Console F9)"
        StatusLabel.TextColor3 = Color3.fromRGB(85, 255, 127)
    else
        warn("[DEBUG AUTO-REJOIN] Gagal: ReNotifyEvent tidak ditemukan di ReplicatedStorage!")
        StatusLabel.Text = "Error: Remote tidak ada!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
    end
end

-- ==========================================
-- 4. LOGIKA DETEKSI NOTIFIKASI
-- ==========================================
local function handleNotification(child)
    task.wait(0.5) -- Tunggu UI render full
    
    if child:IsA("Frame") or child:IsA("GuiObject") then
        local label = child:FindFirstChild("Label")
        if label and label:IsA("TextLabel") and label.Text == "Match still in progress" then
            currentFoundUUID = child.Name
            
            print("========================================")
            print("[DEBUG AUTO-REJOIN] Notifikasi Muncul!")
            print("[DEBUG AUTO-REJOIN] UUID yang diekstrak: " .. tostring(currentFoundUUID))
            print("========================================")
            
            if isAutoRejoinActive then
                StatusLabel.Text = "Auto Menekan Rejoin..."
                executeRejoin(currentFoundUUID)
            else
                StatusLabel.Text = "Notifikasi Siap! Tekan Manual."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
            end
        end
    end
end

local function setupDetection()
    local notifyClientFolder = PlayerGui:WaitForChild("Re:NotifyClient", 15)
    if notifyClientFolder then
        -- Cek yang sudah ada di layar
        for _, child in ipairs(notifyClientFolder:GetChildren()) do
            task.spawn(handleNotification, child)
        end
        -- Cek yang baru muncul
        autoRejoinConnection = notifyClientFolder.ChildAdded:Connect(handleNotification)
        print("[DEBUG AUTO-REJOIN] Script berhasil diinjeksi. Menunggu notifikasi.")
    else
        warn("[DEBUG AUTO-REJOIN] Timeout: Folder Re:NotifyClient tidak ditemukan!")
        StatusLabel.Text = "Gagal menemukan Folder UI."
    end
end

